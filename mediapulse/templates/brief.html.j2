<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Media brief: {{ brief.audience.label }}</title>
<style>
  :root {
    --ink: #1d2433; --muted: #5b6475; --line: #e3e6ec; --bg: #f7f8fa;
    --card: #ffffff; --accent: #2f5d50; --accent-soft: #e6efeb;
  }
  * { box-sizing: border-box; }
  body { margin: 0; font: 16px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, sans-serif;
         color: var(--ink); background: var(--bg); }
  main { max-width: 860px; margin: 0 auto; padding: 48px 20px 64px; }
  .eyebrow { text-transform: uppercase; letter-spacing: .08em; font-size: 12px; color: var(--accent); font-weight: 600; }
  h1 { font-size: 34px; line-height: 1.2; margin: 6px 0 8px; }
  .meta { color: var(--muted); font-size: 14px; }
  .audience { color: var(--muted); margin: 14px 0 0; max-width: 640px; }
  .headline { margin: 28px 0 8px; padding: 18px 22px; background: var(--accent-soft);
              border-left: 4px solid var(--accent); border-radius: 6px; font-size: 18px; }
  .pills { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
  .pill { font-size: 12px; padding: 3px 10px; border-radius: 999px; background: var(--card); border: 1px solid var(--line); color: var(--muted); }
  nav.toc { margin: 28px 0 8px; display: flex; flex-wrap: wrap; gap: 8px; }
  nav.toc a { font-size: 14px; color: var(--accent); text-decoration: none; padding: 6px 12px;
              border: 1px solid var(--line); border-radius: 6px; background: var(--card); }
  section.theme { background: var(--card); border: 1px solid var(--line); border-radius: 10px;
                  padding: 24px 26px; margin-top: 18px; }
  section.theme h2 { margin: 0 0 6px; font-size: 21px; display: flex; justify-content: space-between; gap: 12px; }
  section.theme h2 .count { font-size: 13px; font-weight: 500; color: var(--muted); white-space: nowrap; }
  .why { margin: 10px 0 0; font-size: 15px; }
  .why b { color: var(--accent); }
  ul.articles { list-style: none; padding: 0; margin: 16px 0 0; border-top: 1px solid var(--line); }
  ul.articles li { padding: 10px 0; border-bottom: 1px solid var(--line); }
  ul.articles a { color: var(--ink); font-weight: 550; text-decoration: none; }
  ul.articles a:hover { color: var(--accent); text-decoration: underline; }
  ul.articles .src { display: block; font-size: 13px; color: var(--muted); }
  .angles { margin-top: 16px; }
  .angles h3 { font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 0 0 6px; }
  .angles ul { margin: 0; padding-left: 20px; }
  footer { margin-top: 36px; font-size: 13px; color: var(--muted); }
  footer a { color: var(--accent); }
  @media (max-width: 560px) { h1 { font-size: 27px; } section.theme { padding: 18px; } }
</style>
</head>
<body>
<main>
  <div class="eyebrow">Media brief</div>
  <h1>{{ brief.audience.label }}</h1>
  <div class="meta">
    {{ brief.generated|longdate }} · last {{ brief.days }} days ·
    {{ brief.article_count }} articles from {{ brief.source_names|length }} publications
  </div>
  <p class="audience">{{ brief.audience.description }}</p>
  {% if brief.topics %}
  <div class="pills">{% for t in brief.topics %}<span class="pill">{{ t }}</span>{% endfor %}</div>
  {% endif %}

  {% if brief.headline %}<div class="headline">{{ brief.headline }}</div>{% endif %}

  <nav class="toc">
    {% for t in brief.themes %}<a href="#theme-{{ loop.index }}">{{ t.name }}</a>{% endfor %}
  </nav>

  {% for t in brief.themes %}
  <section class="theme" id="theme-{{ loop.index }}">
    <h2>{{ t.name }} <span class="count">{{ t.articles|length }} article{{ "s" if t.articles|length != 1 }}</span></h2>
    <p>{{ t.summary }}</p>
    {% if t.why_it_matters %}<p class="why"><b>Why it matters:</b> {{ t.why_it_matters }}</p>{% endif %}
    <ul class="articles">
      {% for a in t.articles %}
      <li>
        <a href="{{ a.url }}" target="_blank" rel="noopener">{{ a.title }}</a>
        <span class="src">{{ a.source }}{% if a.published %} · {{ a|shortdate }}{% endif %}</span>
      </li>
      {% endfor %}
    </ul>
    {% if t.angles %}
    <div class="angles">
      <h3>Content angles</h3>
      <ul>{% for x in t.angles %}<li>{{ x }}</li>{% endfor %}</ul>
    </div>
    {% endif %}
  </section>
  {% endfor %}

  <footer>
    Sources: {{ brief.source_names|join(", ") }}.<br>
    Themes by {{ "Claude" if brief.method == "claude" else "keyword grouping (offline)" }}.
    Built with <a href="https://github.com/justfranklin/media-pulse">media-pulse</a>.
  </footer>
</main>
</body>
</html>
